# Copy to .env and fill in locally. NEVER commit real values.
#
# This front end can talk to either network, each with its OWN contract address,
# RPC and deploy block. Addresses are per network and are never shared or
# guessed: a chain with no address shows a "not configured on this network"
# state.
#
# ONLY Ethereum Sepolia is our deployment + manual-verification target.
# Base Sepolia is supported/configurable for a separate deployment by someone
# who has Base Sepolia test ETH; we have NOT deployed to or verified it.

# --- Ethereum Sepolia (chain 11155111) — our target ---
# Address of the deployed PixelTurf contract on Ethereum Sepolia.
VITE_SEPOLIA_CANVAS_ADDRESS=
# Optional dedicated Ethereum Sepolia RPC. Empty => public default.
VITE_SEPOLIA_RPC_URL=
# Block the contract was deployed at (keeps the initial log scan small). Empty => from 0.
VITE_SEPOLIA_DEPLOY_BLOCK=

# --- Base Sepolia (chain 84532) — optional, not deployed/verified by us ---
# Address of a PixelTurf contract deployed on Base Sepolia (leave empty if none).
VITE_BASE_SEPOLIA_CANVAS_ADDRESS=
# Optional dedicated Base Sepolia RPC. Empty => public default.
VITE_BASE_SEPOLIA_RPC_URL=
# Deploy block on Base Sepolia (leave empty if none).
VITE_BASE_SEPOLIA_DEPLOY_BLOCK=
